
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ─────────────────────────────────
JWT_SECRET=changeme-use-a-long-random-string
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ── Database (MySQL) ─────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=chainbreak
DB_PASS=changeme
DB_NAME=chainbreak
DB_ROOT_PASS=changeme-root

# ── AWS / LocalStack (Layer 3) ───────────
LOCALSTACK_URL=http://localstack:4566
AWS_REGION=us-east-1

# ── Security scanning (ZAP) ──────────────
ZAP_API_KEY=changeme-zap-api-key
ZAP_URL=http://zap:8080
ZAP_TARGET=http://nginx

# ── AI hints (optional) ──────────────────
# Server-side only. Leave unset and the hint system falls back to the
# pre-written hints in server/lib/hintContext.js.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Session ───────────────────────────────
SESSION_TTL_MIN=60
